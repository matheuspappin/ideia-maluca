{
  "name": "miwra_automacao",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.miwra.automator",
    "productName": "Miwra Automator",
    "win": {
      "target": "nsis",
